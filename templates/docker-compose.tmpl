services:
  nginx:
    image: nginx:alpine
    container_name: {{.ContainerName}}
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - {{.ConfDir}}/nginx.conf:/etc/nginx/nginx.conf:ro
      - {{.ConfDir}}/sites-enabled:/etc/nginx/conf.d:ro
      - {{.Webroot}}:/var/www/certbot:ro
      - {{.CertsDir}}:/etc/letsencrypt:ro
